{
  "name": "open-gen-studio",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev frontend",
    "build": "next build frontend",
    "start": "next start frontend",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "lint": "eslint frontend",
    "lint:fix": "eslint --fix frontend",
    "format": "prettier --write \"frontend/**/*.{ts,tsx}\" && cargo fmt --manifest-path backend/Cargo.toml",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test:rust": "bun scripts/test-rust.mjs",
    "ipc:types": "cargo run --manifest-path backend/Cargo.toml --bin export-ipc",
    "ipc:check": "bun run ipc:types && git diff --exit-code -- frontend/lib/generated/",
    "check": "bun run typecheck && bun run lint",
    "check:full": "bun run check && bun run test:rust",
    "cleanup": "bun run lint:fix && bun run typecheck && bun run format && graphify update .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.rs": "cargo fmt --manifest-path backend/Cargo.toml --"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
